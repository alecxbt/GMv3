# Required: PostgreSQL connection string for Prisma
DATABASE_URL="postgresql://user:password@localhost:5432/macroterm"

# Optional: Backend listens on this port (default 5001)
PORT=5001

# Optional: Frontend URL for CORS and OAuth redirects (default http://localhost:3000)
FRONTEND_URL=http://localhost:3000

# Optional: Backend URL for OAuth callback (default http://localhost:5001)
BACKEND_URL=http://localhost:5001

# Optional: JWT secret for auth tokens
JWT_SECRET=your-secret-key

# Optional: Google OAuth (for Sign in with Google)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
